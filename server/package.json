{
  "name": "artisan-connect-backend",
  "version": "1.0.0",
  "description": "Backend for ArtisanConnect - A marketplace for local artisans.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" jest",
    "test:integration": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" jest __tests__/integration --runInBand --forceExit",
    "test:perf": "artillery run __tests__/perf/load-test.yml",
    "test:perf:report": "artillery run --output __tests__/perf/report.json __tests__/perf/load-test.yml && artillery report __tests__/perf/report.json"
  },
  "keywords": [
    "artisan",
    "marketplace",
    "ecommerce",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "ArtisanConnect Team",
  "license": "ISC",
  "dependencies": {
    "@arcjet/inspect": "^1.1.0",
    "@arcjet/node": "^1.1.0",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",

    "express-rate-limit": "^8.7.0",
    "express-slow-down": "^3.1.1",
    "helmet": "^8.3.0",

    "hpp": "^0.2.3",
    "joi": "^18.2.5",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cache": "^5.1.2",
    "resend": "^6.25.0",
    "socket.io": "^4.8.3",
    "stripe": "^22.6.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "artillery": "^2.0.30",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
